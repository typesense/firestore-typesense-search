{
  "name": "firestore-typesense-search-workspace",
  "private": true,
  "description": "Workspace for the Firestore → Typesense function kit and Firebase extension",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter ./functions build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter ./functions typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:guard": "node scripts/forbid-escape-hatches.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "pnpm build && vitest run --project integration",
    "emulator": "pnpm build && firebase emulators:start --import=emulator_data",
    "export": "firebase emulators:export emulator_data",
    "typesenseServer": "docker compose up"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@types/node": "^22.20.4",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2",
    "typesense": "^3.0.6",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@11.24.0"
}
